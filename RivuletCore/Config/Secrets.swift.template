import Foundation

nonisolated enum Secrets {
    static let sentryDSN = "YOUR_SENTRY_DSN_HERE"
    /// TMDB API Read Access Token (v4 Bearer token), from
    /// themoviedb.org/settings/api. Sent as `Authorization: Bearer
    /// <token>` directly to api.themoviedb.org — see `TMDBConfig`.
    static let tmdbAccessToken = "YOUR_TMDB_V4_TOKEN_HERE"

    /// OpenSubtitles.com: the API key of a consumer made at
    /// opensubtitles.com/consumers, and the account it downloads as
    /// (`OpenSubtitlesClient`). Empty leaves the source out.
    static let openSubtitlesAPIKey = ""
    static let openSubtitlesUsername = ""
    static let openSubtitlesPassword = ""
    /// SubSource: the key from subsource.net's API page (`SubSourceClient`).
    /// Empty leaves the source out.
    static let subSourceAPIKey = ""
}
